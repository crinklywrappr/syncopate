{:paths ["src" "resources"]
 ;; datalevin is pinned to the LOWEST version we support (the floor), not the
 ;; newest. A plain :mvn/version is a soft/minimum constraint: pinning the floor
 ;; lets consumers choose their own datalevin (a top-level dep wins in tools.deps;
 ;; nearest-wins in Maven/Leiningen) without us dragging anyone up. The `:dl-*`
 ;; test aliases below prove we still work up to the newest supported version.
 ;; Floor = 1.0.1: `datalog-kv` exists (1.0.0+) AND `update-schema` PATCHES an
 ;; existing attr rather than replacing it (1.0.1+) — 1.0.0 clobbers, which would
 ;; silently corrupt `:schema/alter`, so it is not supported.
 :deps {org.clojure/clojure {:mvn/version "1.12.5"}
        datalevin/datalevin {:mvn/version "1.0.1"}
        dev.weavejester/ragtime.core {:mvn/version "0.12.1"}
        com.taoensso/trove {:mvn/version "1.1.0"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {org.clojure/test.check {:mvn/version "1.1.3"}
                      lambdaisland/kaocha {:mvn/version "1.91.1392"}
                      lambdaisland/kaocha-cloverage {:mvn/version "1.1.89"}}}
  ;; datalevin support matrix. Each alias overrides the version so we can run the
  ;; suite against the whole supported range (floor .. newest). Selected via
  ;; `clojure -T:build test :dl "1.0.2"` (build.clj layers the matching alias onto
  ;; the spawned test JVM's basis). :override-deps replaces the version of a lib
  ;; already in :deps.
  :dl-1.0.1 {:override-deps {datalevin/datalevin {:mvn/version "1.0.1"}}}
  :dl-1.0.2 {:override-deps {datalevin/datalevin {:mvn/version "1.0.2"}}}
  :dl-1.1.0 {:override-deps {datalevin/datalevin {:mvn/version "1.1.0"}}}
  :build {:deps {io.github.clojure/tools.build {:mvn/version "0.10.14"}
                 slipset/deps-deploy {:mvn/version "0.2.5"}}
          :ns-default build
          :jvm-opts ["-Dslf4j.internal.verbosity=WARN"]}
  :dev {:jvm-opts ["--add-opens=java.base/java.nio=ALL-UNNAMED"
                   "--add-opens=java.base/sun.nio.ch=ALL-UNNAMED"
                   "--enable-native-access=ALL-UNNAMED"]}
  ;; A real, separate datalevin server for the client/server test run
  ;; (`clojure -T:build test :remote true` connects to it). Data under
  ;; data/test-server (gitignored); per-test unique db names keep tests isolated.
  :server {:main-opts ["-m" "datalevin.main" "serv" "-r" "data/test-server" "-p" "8898"]
           :jvm-opts  ["--add-opens=java.base/java.nio=ALL-UNNAMED"
                       "--add-opens=java.base/sun.nio.ch=ALL-UNNAMED"
                       "--enable-native-access=ALL-UNNAMED"]}}}
