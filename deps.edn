{:paths ["src"]
 ;; datalevin is pinned to the LOWEST version we support (the floor), not the
 ;; newest. A plain :mvn/version is a soft/minimum constraint: pinning the floor
 ;; lets consumers choose their own datalevin (a top-level dep wins in tools.deps;
 ;; nearest-wins in Maven/Leiningen) without us dragging anyone up. The `:ci`
 ;; alias below lists the versions we actually test up to the newest supported.
 ;; The rationale for the current floor (why it sits where it does, and any
 ;; releases skipped along the way) lives in the CHANGELOG, not here, so this
 ;; comment stays correct as the floor and the matrix move.
 :deps {org.clojure/clojure {:mvn/version "1.12.5"}
        datalevin/datalevin {:mvn/version "1.2.2"}
        dev.weavejester/ragtime.core {:mvn/version "0.12.1"}
        com.taoensso/trove {:mvn/version "1.1.0"}}
 :aliases
 {:test {:extra-paths ["test" "test/resources"]
         :extra-deps {org.clojure/test.check {:mvn/version "1.1.3"}
                      lambdaisland/kaocha {:mvn/version "1.91.1392"}
                      lambdaisland/kaocha-cloverage {:mvn/version "1.1.89"}}}
  ;; SOURCE OF TRUTH for the datalevin support matrix (floor .. newest). CI reads
  ;; this to build its test matrix (`clojure -T:build matrix`), `test-all` runs
  ;; the whole range locally, and the scheduled `datalevin-watch` workflow appends
  ;; new releases here via `bump-matrix`. Data-only alias (never activated), so it
  ;; doesn't affect resolution. Embedded suite runs every version; the client/
  ;; server suite runs the min and max. Any one version is selectable via
  ;; `clojure -T:build test :dl "<version>"` (build.clj injects it as an :extra dep).
  :ci {:datalevin/versions ["1.2.2" "1.2.5" "1.2.6" "1.2.7"]}
  :build {:deps {io.github.clojure/tools.build {:mvn/version "0.10.14"}
                 slipset/deps-deploy {:mvn/version "0.2.5"}
                 ;; matrix single-sourcing: structural deps.edn edits (bump-matrix)
                 ;; + Clojars JSON parsing (bump-matrix) / JSON matrix output (matrix)
                 rewrite-clj/rewrite-clj {:mvn/version "1.1.48"}
                 org.clojure/data.json {:mvn/version "2.5.1"}}
          :ns-default build
          :jvm-opts ["-Dslf4j.internal.verbosity=WARN"]}
  :dev {:jvm-opts ["--add-opens=java.base/java.nio=ALL-UNNAMED"
                   "--add-opens=java.base/sun.nio.ch=ALL-UNNAMED"
                   "--enable-native-access=ALL-UNNAMED"]}
  ;; A real, separate datalevin server for the client/server test run
  ;; (`clojure -T:build test :remote true` connects to it). Data under
  ;; data/test-server (gitignored); per-test unique db names keep tests isolated.
  :server {:main-opts ["-m" "datalevin.main" "serv" "-r" "data/test-server" "-p" "8898"]
           :jvm-opts  ["--add-opens=java.base/java.nio=ALL-UNNAMED"
                       "--add-opens=java.base/sun.nio.ch=ALL-UNNAMED"
                       "--enable-native-access=ALL-UNNAMED"]}}}
