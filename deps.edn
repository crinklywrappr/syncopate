{:paths ["src" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.12.5"}
        datalevin/datalevin {:mvn/version "1.1.0"}
        dev.weavejester/ragtime.core {:mvn/version "0.12.1"}
        com.taoensso/trove {:mvn/version "1.1.0"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {org.clojure/test.check {:mvn/version "1.1.3"}
                      lambdaisland/kaocha {:mvn/version "1.91.1392"}
                      lambdaisland/kaocha-cloverage {:mvn/version "1.1.89"}}}
  :build {:deps {io.github.clojure/tools.build {:mvn/version "0.10.14"}
                 slipset/deps-deploy {:mvn/version "0.2.5"}}
          :ns-default build
          :jvm-opts ["-Dslf4j.internal.verbosity=WARN"]}
  :dev {:jvm-opts ["--add-opens=java.base/java.nio=ALL-UNNAMED"
                   "--add-opens=java.base/sun.nio.ch=ALL-UNNAMED"
                   "--enable-native-access=ALL-UNNAMED"]}
  ;; A real, separate datalevin server for the client/server test run
  ;; (`clojure -T:build test :remote true` connects to it). Data under
  ;; data/test-server (gitignored); per-test unique db names keep tests isolated.
  :server {:main-opts ["-m" "datalevin.main" "serv" "-r" "data/test-server" "-p" "8898"]
           :jvm-opts  ["--add-opens=java.base/java.nio=ALL-UNNAMED"
                       "--add-opens=java.base/sun.nio.ch=ALL-UNNAMED"
                       "--enable-native-access=ALL-UNNAMED"]}}}
